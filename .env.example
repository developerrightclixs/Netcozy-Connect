# Supabase development project. Keep actual values in ignored .env.
# Get the project URL and new sb_publishable_ key from Connect / API Keys.
# Never use a secret or service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Must match the browser origin and Supabase Auth Site URL.
APP_BASE_URL=http://localhost:3000
# Phase 4 manual/demo Studio uses the same authenticated Supabase connection.
# AI generation, social publishing, provider analytics and billing are BLOCKED.
# Do not add unused provider keys; configure secrets only when a real adapter is implemented.
