# Supabase development project. Keep actual values in ignored .env.
# Get the project URL and new sb_publishable_ key from Connect / API Keys.
# Never use a secret or service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Must match the browser origin and Supabase Auth Site URL.
APP_BASE_URL=http://localhost:3000
